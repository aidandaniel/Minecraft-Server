# Grafana Configuration
# Set a secure password for Grafana admin user
GRAFANA_ADMIN_PASSWORD=your_secure_password_here

# Minecraft Java username for operator (no spaces around =)
minecraftUser=YourMinecraftName

# Java Edition usernames allowed to join, comma-separated. Include yourself.
# Names added only with /whitelist add are removed on the next start.
WHITELIST=YourMinecraftName
